// hACL protected allow-list modification draft.
// Requires Audit File System, an object SACL, and Security event 4663 ingestion.
let ProtectedFileSuffix = @"\allow_list.txt";
let WriteMasks = dynamic([
    "0x2",      // write data / add file
    "0x4",      // append data / add subdirectory
    "0x10",     // write extended attributes
    "0x40",     // delete child
    "0x100",    // write attributes
    "0x10000",  // delete
    "0x40000",  // write DACL
    "0x80000"   // write owner
]);
SecurityEvent
| where EventID == 4663
| where ObjectName endswith ProtectedFileSuffix
| where AccessMask in~ (WriteMasks)
| project
    TimeGenerated,
    Computer,
    SubjectAccount = strcat(SubjectDomainName, @"\", SubjectUserName),
    ObjectName,
    ProcessName,
    AccessMask,
    HandleId
| order by TimeGenerated asc
