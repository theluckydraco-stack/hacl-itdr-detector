// Microsoft Sentinel / Log Analytics demonstration query.
// Thresholds are lab defaults and must be tuned to the environment.
let Window = 10m;
let MinimumFailures = 5;
let MinimumAccounts = 5;
SecurityEvent
| where EventID == 4625
| where isnotempty(IpAddress) and isnotempty(TargetAccount)
| summarize
    FailedAttempts = count(),
    DistinctAccounts = dcount(TargetAccount),
    TargetedAccounts = make_set(TargetAccount, 100),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
  by IpAddress, bin(TimeGenerated, Window)
| where FailedAttempts >= MinimumFailures
| where DistinctAccounts >= MinimumAccounts
| project
    TimeGenerated,
    IpAddress,
    FailedAttempts,
    DistinctAccounts,
    TargetedAccounts,
    FirstSeen,
    LastSeen,
    MITRETechnique = "T1110.003"
